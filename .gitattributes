# Normalize line endings for source and scripts.
* text=auto eol=lf

*.py text
*.sh text eol=lf
*.desktop text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text
*.1 text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.AppImage binary
*.deb binary
